# Port the API listens on (default 4000).
ARCHX_PORT=4000

# --- Database (REQUIRED) ---
# Postgres connection string. Use a free Neon database: https://neon.tech
# Copy the "pooled" connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Auth ---
# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=7d

# Scratch space for cloned repos during analysis (default ./data). Not a DB.
ARCHX_DATA_DIR=data

# Comma-separated allowed CORS origins, or "*" for any (default "*").
ARCHX_CORS_ORIGIN=*

# --- LLM provider (leave all unset to use the deterministic engine) ---
# Recommended: a FREE Grok model via OpenRouter. Get a key at
# https://openrouter.ai/keys — the assistant then uses x-ai/grok-4-fast:free.
# OPENROUTER_API_KEY=sk-or-...

# Or talk to xAI (Grok) directly: https://console.x.ai
# XAI_API_KEY=xai-...

# Optional overrides (any OpenAI-compatible endpoint works):
# AI_MODEL=x-ai/grok-4-fast:free       # e.g. openrouter/free, x-ai/grok-4.1-fast:free, grok-4-fast
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=                           # generic key if not using the ones above
