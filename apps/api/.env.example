# Port the API listens on (default 4000).
ARCHX_PORT=4000

# Where analyzed projects and saved boards are persisted (default ./data).
ARCHX_DATA_DIR=data

# Comma-separated allowed CORS origins, or "*" for any (default "*").
ARCHX_CORS_ORIGIN=*

# --- Optional LLM provider (leave unset to use the deterministic engine) ---
# The MVP ships without a network provider; wire one up in
# packages/ai/src/provider.ts (createProviderFromEnv) and read your key here.
# OPENAI_API_KEY=
