{
  "name": "ai-architecture-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub repo -> static analysis -> dependency/call graph -> Architecture IR -> UML diagrams -> interactive board -> AI assistant.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "api": "npm run dev --workspace @archx/api",
    "web": "npm run dev --workspace @archx/web",
    "dev": "concurrently -n api,web -c blue,green \"npm:api\" \"npm:web\"",
    "build": "npm run build --workspace @archx/web"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
